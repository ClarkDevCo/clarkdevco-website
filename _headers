# Netlify / Cloudflare Pages caching
/assets/images/*
  Cache-Control: public, max-age=2592000
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/video/*
  Cache-Control: public, max-age=2592000
/assets/css/*
  Cache-Control: public, max-age=3600
/assets/js/*
  Cache-Control: public, max-age=3600
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
